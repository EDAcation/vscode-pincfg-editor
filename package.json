{
  "name": "pincfg-editor",
  "displayName": "Pin Constraint Editor",
  "description": "Visual editor for PCF, LPF and CST files based on Lushay Code",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fpga",
    "cst",
    "pcf",
    "lpf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EDAcation/vscode-pincfg-editor"
  },
  "icon": "icon.png",
  "activationEvents": [],
  "publisher": "edacation",
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lushay-code.constraintsEditor",
        "displayName": "Constraints Editor",
        "selector": [
          {
            "filenamePattern": "*.cst"
          },
          {
            "filenamePattern": "*.pcf"
          },
          {
            "filenamePattern": "*.lpf"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "cst",
        "extensions": [
          ".cst"
        ],
        "aliases": [
          "CST File"
        ],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      },
      {
        "id": "pcf",
        "extensions": [
          ".pcf"
        ],
        "aliases": [
          "PCF File"
        ],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      },
      {
        "id": "lpf",
        "extensions": [
          ".lpf"
        ],
        "aliases": [
          "LPF File"
        ],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "bundle": "vsce package"
  },
  "devDependencies": {
    "@types/cli-spinner": "^0.2.1",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.72.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.8.2",
    "ts-loader": "^9.5.4",
    "typescript": "^4.8.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.32",
    "@vscode/webview-ui-toolkit": "^1.2.0"
  }
}
